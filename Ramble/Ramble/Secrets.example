import Foundation

enum Secrets {
    // Set this to a shared secret matching your Cloudflare Worker's DEV_BYPASS_TOKEN
    // to skip JWS verification during local development.
    // Leave nil to use real StoreKit JWS verification.
    static let devBypassToken: String? = nil
}
