GROQ_API_KEY=your-groq-api-key-here
DEEPGRAM_API_KEY=your-deepgram-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Dev bypass token — skips JWS subscription verification when the app sends
# "Authorization: DevBypass <token>". Must match Secrets.devBypassToken in the iOS app.
# Only used during local development. Do NOT set this in production.
DEV_BYPASS_TOKEN=
